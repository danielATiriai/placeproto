{
	admin off
	auto_https off
}

:{$PORT:8080} {
	log {
		output stdout
		format console
	}

	encode zstd gzip

	root * /srv

	handle /healthz {
		respond "ok" 200
	}

	@offapex not host placeproto.org
	header @offapex X-Robots-Tag "noindex, nofollow"

	@www host www.placeproto.org
	handle @www {
		redir https://placeproto.org{uri} permanent
	}

	@documents path / *.html *.css
	header @documents Cache-Control "public, max-age=0, must-revalidate"

	@lexicons path /lexicons/* /release-manifest.json
	header @lexicons Access-Control-Allow-Origin "*"

	handle {
		file_server
	}
}
